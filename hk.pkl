amends "pkl/Config.pkl"

// Seeded by `pklith seed`; yours to edit. The steps come from hk.pklith.pkl,
// which `pklith gen` and `pklith lay` write from .pklith: shape them here
// (excludes, depends) by amending a step by its id.
import "hk.pklith.pkl" as generated

// SPEC-PROMPT.md is frozen (root T3). Its one hit is upstream's CI runner
// path in a RUNPATH it quotes, not a local one; only no-local-paths skips it.
local commit = (generated.steps) {
  when (generated.steps.containsKey("no-local-paths")) {
    ["no-local-paths"] { exclude = List("SPEC-PROMPT.md") }
  }
}
local all = (commit) { ...generated.push }

hooks {
  ["pre-commit"] {
    fix = true
    // "none", not "git": the git stash is shared by every worktree, and
    // `sherd wave` (root T8) runs parallel workers in worktrees, so one
    // hook could pop another checkout's files (actlith nix:B5).
    stash = "none"
    steps = commit
  }
  ["pre-push"] {
    steps = all
  }
  ["check"] {
    steps = all
  }
  ["fix"] {
    fix = true
    // hk 2.x stages fixes only in pre-commit unless a hook asks for it.
    stage = true
    steps = all
  }
}
